<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set root logging to WARN so verbose CloudSim internal events don't overwhelm output -->
    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="org.cloudsimplus" level="ERROR" />

    <!-- Allow our project logs through at INFO level -->
    <logger name="com.cloudallocation" level="INFO" />
</configuration>
